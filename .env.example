# Salin nilainya ke Vercel → Project → Settings → Environment Variables.
# Jangan commit file .env asli.

# API key Resend (wajib agar form benar-benar mengirim email)
RESEND_API_KEY=

# Inbox yang menerima pesan dari form
CONTACT_TO_EMAIL=

# Opsional: pengirim. Sebelum domain diverifikasi di Resend, gunakan onboarding@resend.dev
RESEND_FROM_EMAIL=

# Opsional: domain produksi untuk metadata, sitemap, dan robots
NEXT_PUBLIC_SITE_URL=
